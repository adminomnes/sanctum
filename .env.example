# Port for Express API server
PORT=3001

# JWT Secret for admin authentication tokens
JWT_SECRET=sanctum_jwt_secret_key_2026_super_secure

# Optional: Path to SQLite database file (defaults to ./data/sanctum.db)
# DB_PATH=/var/data/sanctum.db

# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=https://sanctum-bfi.pages.dev,https://sanctum.servex.com

# Frontend environment variable (set during frontend build to point to Render API)
# VITE_API_URL=https://sanctum-api.onrender.com

